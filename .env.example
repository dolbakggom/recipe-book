# Local development uses SQLite.
DATABASE_URL="file:./dev.db"

# Production uses Postgres. Set this in Vercel to a pooled runtime connection.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

GEMINI_API_KEY=""
